{
  "name": "cli-diff-review",
  "displayName": "Cli Diff Review",
  "description": "Cli Diff Review brings lightweight code change review for CLI-assisted edits to VS Code.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M00100111/Cli-Diff-Review.git"
  },
  "icon": "resources/icon.png",
  "publisher": "local",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cli-diff.startGitReview",
    "onCommand:cli-diff.acceptChange",
    "onCommand:cli-diff.rejectChange",
    "onCommand:cli-diff.acceptFile",
    "onCommand:cli-diff.rejectFile",
    "onCommand:cli-diff.undoFile",
    "onCommand:cli-diff.acceptAll",
    "onCommand:cli-diff.rejectAll",
    "onCommand:cli-diff.undoAll",
    "onCommand:cli-diff.nextChange",
    "onCommand:cli-diff.previousChange",
    "onCommand:cli-diff.openReviewView",
    "onCommand:cli-diff.refresh",
    "onCommand:cli-diff.initializeLlmWiki",
    "onCommand:cli-diff.updateLlmWiki",
    "onCommand:cli-diff.generateAiReview",
    "onCustomEditor:cli-diff.reviewEditor",
    "onView:cli-diff.dashboard",
    "onView:cli-diff.review"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cli-diff.startGitReview",
        "title": "Start Git Review",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.acceptChange",
        "title": "Accept Change",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.rejectChange",
        "title": "Reject Change",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.acceptFile",
        "title": "Accept File",
        "category": "Cli Diff Review",
        "icon": "$(check)"
      },
      {
        "command": "cli-diff.rejectFile",
        "title": "Reject File",
        "category": "Cli Diff Review",
        "icon": "$(close)"
      },
      {
        "command": "cli-diff.undoFile",
        "title": "Undo File",
        "category": "Cli Diff Review",
        "icon": "$(discard)"
      },
      {
        "command": "cli-diff.acceptAll",
        "title": "Accept All",
        "category": "Cli Diff Review",
        "icon": "$(check)"
      },
      {
        "command": "cli-diff.rejectAll",
        "title": "Reject All",
        "category": "Cli Diff Review",
        "icon": "$(close)"
      },
      {
        "command": "cli-diff.undoAll",
        "title": "Undo All",
        "category": "Cli Diff Review",
        "icon": "$(discard)"
      },
      {
        "command": "cli-diff.nextChange",
        "title": "Next Change",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.previousChange",
        "title": "Previous Change",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.openReviewView",
        "title": "Open Review",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.refresh",
        "title": "Refresh and Stage Reviewed Changes",
        "category": "Cli Diff Review",
        "icon": "$(refresh)"
      },
      {
        "command": "cli-diff.initializeLlmWiki",
        "title": "Initialize LLM Code Wiki",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.updateLlmWiki",
        "title": "Update LLM Code Wiki",
        "category": "Cli Diff Review"
      },
      {
        "command": "cli-diff.generateAiReview",
        "title": "Generate AI Review",
        "category": "Cli Diff Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cli-diff-activity",
          "title": "Cli Diff Review",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "cli-diff.review",
          "name": "Cli Diff Review"
        }
      ],
      "cli-diff-activity": [
        {
          "id": "cli-diff.dashboard",
          "name": "Cli Diff Review",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "cli-diff.reviewEditor",
        "displayName": "Cli Diff Review",
        "selector": [
          {
            "filenamePattern": "**/*"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "cli-diff.acceptFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFilePending",
          "group": "inline@1"
        },
        {
          "command": "cli-diff.acceptFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFilePendingReviewed",
          "group": "inline@1"
        },
        {
          "command": "cli-diff.rejectFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFilePending",
          "group": "inline@2"
        },
        {
          "command": "cli-diff.rejectFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFilePendingReviewed",
          "group": "inline@2"
        },
        {
          "command": "cli-diff.undoFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFilePending",
          "group": "inline@3"
        },
        {
          "command": "cli-diff.undoFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFileReviewed",
          "group": "inline@3"
        },
        {
          "command": "cli-diff.undoFile",
          "when": "view == cli-diff.review && viewItem == cliDiffFilePendingReviewed",
          "group": "inline@3"
        }
      ],
      "view/title": [
        {
          "command": "cli-diff.acceptAll",
          "when": "view == cli-diff.review",
          "group": "navigation@1"
        },
        {
          "command": "cli-diff.rejectAll",
          "when": "view == cli-diff.review",
          "group": "navigation@2"
        },
        {
          "command": "cli-diff.undoAll",
          "when": "view == cli-diff.review",
          "group": "navigation@3"
        },
        {
          "command": "cli-diff.refresh",
          "when": "view == cli-diff.review",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Cli Diff Review",
      "properties": {
        "cliDiff.autoStartGitReview": {
          "type": "boolean",
          "order": 1,
          "default": true,
          "description": "Automatically start a lightweight Git review session so changed files appear in the Cli Diff Review view."
        },
        "cliDiff.refreshDebounceMs": {
          "type": "number",
          "order": 2,
          "default": 500,
          "minimum": 0,
          "description": "Debounce delay, in milliseconds, for file, Git metadata, Git extension state, and AI/Wiki Dashboard refresh events. Editor text changes still refresh only after save."
        },
        "cliDiff.reviewWikiChanges": {
          "type": "boolean",
          "order": 3,
          "default": true,
          "description": "Include Git-detected changes under .agents/skills/llm-code-wiki in Cli Diff Review. Disable to ignore that directory."
        },
        "cliDiff.reviewEditorMode": {
          "type": "string",
          "order": 4,
          "enum": [
            "nativeEditor",
            "reviewPage"
          ],
          "enumItemLabels": [
            "Native inline diff editor",
            "Review page"
          ],
          "default": "nativeEditor",
          "description": "Controls whether review files open in the VS Code/Cursor native inline diff editor or the Cli Diff Review page."
        },
        "cliDiff.aiReviewStrategy": {
          "type": "string",
          "order": 5,
          "enum": [
            "Auto",
            "Multi",
            "FileOnly"
          ],
          "default": "Multi",
          "description": "AI Review agent strategy. Auto chooses between lightweight file review and multi-agent review; Multi always runs planning and integration review; FileOnly uses only per-file review."
        },
        "cliDiff.aiReviewMaxRounds": {
          "type": "number",
          "order": 6,
          "default": 32,
          "minimum": 0,
          "description": "Maximum rounds for each AI Review agent. Applies to knowledge, planning, file, and integration agents. 0 means unlimited."
        },
        "cliDiff.aiReviewFileConcurrency": {
          "type": "number",
          "order": 7,
          "default": 3,
          "minimum": 0,
          "description": "Maximum number of file-level AI review agents to run concurrently. 1 runs serially; 0 runs all pending files concurrently."
        },
        "cliDiff.aiReviewLanguage": {
          "type": "string",
          "order": 8,
          "enum": [
            "zh-CN",
            "en"
          ],
          "default": "zh-CN",
          "description": "AI review findings language."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "monaco-editor": "^0.55.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
